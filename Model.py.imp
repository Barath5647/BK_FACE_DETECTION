# Colab-ready cell: Training using pseudo-labels ONLY (no labels.csv read)
# Assumes: scikit-learn and opencv were installed in prior cell.
import os, json, numpy as np
from sklearn.cluster import KMeans
import tensorflow as tf
from tensorflow import keras
from tensorflow.keras import layers
from tensorflow.keras.applications import MobileNetV2
from tensorflow.keras.applications.mobilenet_v2 import preprocess_input as mb_preprocess
from tensorflow.keras import mixed_precision

# ---------- CONFIG (edit these) ----------
IMAGE_DIR = "/content/drive/MyDrive/images"   # <--- change if needed
MODEL_OUT = "/content/drive/MyDrive/best_model.h5"
CLASS_JSON = "/content/drive/MyDrive/class_names.json"
IMG_SIZE = (160, 160)     # reduce to (128,128) or (96,96) if OOM
BATCH = 16                # reduce if OOM
BATCH_EMB = 32            # batch used only for embedding extraction
EPOCHS = 12               # fine-tune epochs
NUM_CLASSES_OVERRIDE = None   # set int to force number of clusters/classes
VAL_FRAC = 0.18
RANDOM_SEED = 42

tf.random.set_seed(RANDOM_SEED)
np.random.seed(RANDOM_SEED)

# enable mixed precision if supported (optional)
try:
    mixed_precision.set_global_policy('mixed_float16')
    print("Mixed precision policy set.")
except Exception as e:
    print("Mixed precision unavailable:", e)

# ---------- list image files ----------
def list_images(folder):
    exts = ('.jpg', '.jpeg', '.png')
    return sorted([f for f in os.listdir(folder) if f.lower().endswith(exts)])

files = list_images(IMAGE_DIR)
if len(files) == 0:
    raise SystemExit("No images found in IMAGE_DIR: " + IMAGE_DIR)
paths = np.array([os.path.join(IMAGE_DIR, f) for f in files])
n = len(paths)
print("Found", n, "images.")

# ---------- 1) compute embeddings with MobileNetV2 (batched) ----------
print("Building embedding dataset (batched)...")
def _make_emb_ds(paths):
    ds = tf.data.Dataset.from_tensor_slices(paths.astype(str))
    def _read(path):
     try:
        img = tf.io.read_file(path)
        img = tf.image.decode_jpeg(img, channels=3)   # force 3 channels
        img = tf.image.resize(img, IMG_SIZE)
        img = img / 255.0
        return img
     except:
        print(f"⚠️ Skipping bad file: {path.numpy().decode()}")
        return tf.zeros([*IMG_SIZE, 3])   # return dummy image to keep pipeline running

    ds = ds.map(lambda p: _read(p), num_parallel_calls=tf.data.AUTOTUNE)
    ds = ds.batch(BATCH_EMB).prefetch(tf.data.AUTOTUNE)
    return ds

emb_ds = _make_emb_ds(paths)
backbone = MobileNetV2(weights='imagenet', include_top=False, pooling='avg',
                      input_shape=(*IMG_SIZE, 3))
print("Extracting embeddings (this may take a while depending on GPU)...")
embeddings = backbone.predict(emb_ds, verbose=1)  # shape (n, embedding_dim)
print("Embeddings shape:", embeddings.shape)
del backbone

# ---------- 2) KMeans to create pseudo-labels ----------
k = NUM_CLASSES_OVERRIDE or max(2, min(20, max(2, n // 8)))  # heuristic
print("Clustering into k =", k, "clusters (you can set NUM_CLASSES_OVERRIDE).")
km = KMeans(n_clusters=k, random_state=RANDOM_SEED)
labels = km.fit_predict(embeddings).astype(np.int32)
num_classes = int(labels.max() + 1)
print("Num classes (derived):", num_classes)

# optional: save class names (0..N-1)
class_names = [f"class_{i}" for i in range(num_classes)]
with open(CLASS_JSON, "w") as fh:
    json.dump(class_names, fh)
print("Saved class mapping to", CLASS_JSON)

# ---------- 3) prepare tf.data train/val datasets ----------
# shuffle indices and split
idx = np.arange(n)
np.random.seed(RANDOM_SEED); np.random.shuffle(idx)
split = int(n * (1 - VAL_FRAC))
train_idx, val_idx = idx[:split], idx[split:]

def path_label_ds(paths, labels, augment=False, batch_size=32):
    def _load(path, label):
        img = tf.io.read_file(path)
        img = tf.image.decode_jpeg(img, channels=3)
        img = tf.image.resize(img, IMG_SIZE)
        img = img / 255.0
        return img, label

    ds = tf.data.Dataset.from_tensor_slices((paths, labels))
    ds = ds.map(_load, num_parallel_calls=tf.data.AUTOTUNE)

    if augment:
        ds = ds.map(lambda x, y: (tf.image.random_flip_left_right(x), y),
                    num_parallel_calls=tf.data.AUTOTUNE)

    ds = ds.batch(batch_size).prefetch(tf.data.AUTOTUNE)
    return ds

train_ds = path_label_ds(paths[train_idx], labels[train_idx], augment=True)
val_ds = path_label_ds(paths[val_idx], labels[val_idx], augment=False)

# ---------- 4) build model (transfer learning) ----------
base = MobileNetV2(weights='imagenet', include_top=False, pooling='avg',
                   input_shape=(*IMG_SIZE, 3))
base.trainable = False

inputs = layers.Input(shape=(*IMG_SIZE, 3))
x = base(inputs, training=False)
x = layers.Dense(128, activation='relu')(x)
x = layers.BatchNormalization()(x)
x = layers.Dropout(0.4)(x)
# make final layer dtype float32 for numeric stability when mixed precision is on
outputs = layers.Dense(num_classes, activation='softmax', dtype='float32')(x)
model = keras.Model(inputs, outputs, name="mobilenet_pseudo")

model.compile(
    optimizer=keras.optimizers.Adam(1e-4),
    loss='sparse_categorical_crossentropy',
    metrics=['accuracy']  # or ['sparse_categorical_accuracy']
)

model.summary()

# ---------- 5) callbacks ----------
logdir = "/content/drive/MyDrive/training_logs"
os.makedirs(logdir, exist_ok=True)
callbacks = [
    keras.callbacks.ModelCheckpoint(MODEL_OUT, save_best_only=True, monitor='val_loss'),
    keras.callbacks.EarlyStopping(monitor='val_loss', patience=6, restore_best_weights=True),
    keras.callbacks.ReduceLROnPlateau(monitor='val_loss', factor=0.5, patience=3, min_lr=1e-6),
    keras.callbacks.TensorBoard(log_dir=logdir)
]

# ---------- 6) train head ----------
print("Training head (few epochs)...")
model.fit(train_ds, validation_data=val_ds, epochs=4, callbacks=callbacks)

# ---------- 7) fine-tune (optional) ----------
print("Starting fine-tune: unfreezing top layers of base model...")
base.trainable = True
total = len(base.layers)
fine_from = int(total * 0.7)
for i, layer in enumerate(base.layers):
    layer.trainable = (i >= fine_from)

model.compile(
    optimizer=keras.optimizers.Adam(1e-5),
    loss='sparse_categorical_crossentropy',
    metrics=['accuracy']
)

print(f"Fine-tuning for {EPOCHS} epochs...")
model.fit(train_ds, validation_data=val_ds, epochs=EPOCHS, callbacks=callbacks)

# ---------- 8) final save ----------
model.save(MODEL_OUT)
print("Done. Model saved to:", MODEL_OUT)
print("TensorBoard logs:", logdir)
